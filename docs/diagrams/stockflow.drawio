        </mxCell>
        <mxCell id="p03-32" value="Allowed status: CREATED or CANCELLED.&#xa;cancelled_at is present exactly when CANCELLED.&#xa;Customer is text, not a foreign key." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#64748B;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" parent="1" vertex="1">
