        <mxCell id="p03-55" value="&lt;div style=&quot;font-family:Arial;font-size:16px;color:#0F172A;font-weight:700;line-height:1.3;&quot;&gt;Relationship legend&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:14px;color:#334155;line-height:1.5;margin-top:9px;&quot;&gt;PK = primary key&lt;br&gt;FK = foreign key&lt;br&gt;UQ = unique key&lt;br&gt;0..* = zero or many&lt;br&gt;Only fields marked NULL are nullable.&lt;br&gt;SKU: 1–64 chars; name/customer: 1–160.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=17;spacingTop=10;spacingBottom=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;fontFamily=Arial;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="60" y="1265" width="480" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p03-56" value="&lt;div style=&quot;font-family:Arial;font-size:16px;color:#0F172A;font-weight:700;line-height:1.3;&quot;&gt;Schema versus use-case rules&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:14px;color:#334155;line-height:1.5;margin-top:9px;&quot;&gt;The FK permits zero item rows per order; the API requires 1–100 distinct items when creating an order. Products with history are retained.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=17;spacingTop=10;spacingBottom=10;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.4;fontFamily=Arial;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="590" y="1265" width="550" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p03-57" value="&lt;div style=&quot;font-family:Arial;font-size:16px;color:#0F172A;font-weight:700;line-height:1.3;&quot;&gt;History and infrastructure&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13px;color:#334155;line-height:1.5;margin-top:9px;&quot;&gt;No cascade deletes.&lt;br&gt;created_at defaults to now().&lt;br&gt;Indexes support product history and order reads.&lt;br&gt;Goose migration bookkeeping is omitted from this business ERD.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=17;spacingTop=10;spacingBottom=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;fontFamily=Arial;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="1190" y="1265" width="450" height="190" as="geometry" />
        </mxCell>
