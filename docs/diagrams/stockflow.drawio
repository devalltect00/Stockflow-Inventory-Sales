        <mxCell id="p01-4" value="01  System overview" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=32;fontColor=#0F172A;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="60" y="77" width="1480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p01-5" value="One operator-facing workspace. React consumes a real Go API; PostgreSQL owns durable inventory." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#475569;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="60" y="139" width="1480" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p01-6" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#E2E8F0;strokeWidth=1.2;dashed=0;" parent="1" vertex="1">
          <mxGeometry x="60" y="197" width="1480" height="2" as="geometry" />
        </mxCell>
        <mxCell id="p01-14" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FBFCFE;strokeColor=#CBD5E1;strokeWidth=1.2;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="360" y="245" width="1180" height="400" as="geometry" />
        </mxCell>
        <mxCell id="p01-15" value="STOCKFLOW APPLICATION" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#64748B;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="390" y="260" width="900" height="25" as="geometry" />
        </mxCell>
        <mxCell id="p01-16" value="&lt;div style=&quot;font-family:Arial;font-size:16px;color:#0F172A;font-weight:700;line-height:1.3;&quot;&gt;Warehouse supervisor&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:14px;color:#334155;line-height:1.5;margin-top:9px;&quot;&gt;Manage products&lt;br&gt;Receive or remove stock&lt;br&gt;Record and cancel sales&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=17;spacingTop=10;spacingBottom=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;fontFamily=Arial;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="60" y="345" width="250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p01-17" value="&lt;div style=&quot;font-family:Arial;font-size:16px;color:#0F172A;font-weight:700;line-height:1.3;&quot;&gt;React browser UI&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:14px;color:#334155;line-height:1.5;margin-top:9px;&quot;&gt;TypeScript + Vite&lt;br&gt;Products and sales orders&lt;br&gt;Forms, query cache, visible errors&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=17;spacingTop=10;spacingBottom=10;fillColor=#ECFDF5;strokeColor=#0F766E;strokeWidth=1.4;fontFamily=Arial;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="400" y="345" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p01-18" value="&lt;div style=&quot;font-family:Arial;font-size:16px;color:#0F172A;font-weight:700;line-height:1.3;&quot;&gt;Go API&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:14px;color:#334155;line-height:1.5;margin-top:9px;&quot;&gt;HTTP handlers → services → stores&lt;br&gt;Validate requests and business rules&lt;br&gt;Own transaction boundaries&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=17;spacingTop=10;spacingBottom=10;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.4;fontFamily=Arial;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="830" y="345" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p01-19" value="&lt;div style=&quot;font-family:Arial;font-size:16px;color:#0F172A;font-weight:700;line-height:1.3;&quot;&gt;PostgreSQL&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:14px;color:#334155;line-height:1.5;margin-top:9px;&quot;&gt;Products + stock movements&lt;br&gt;Orders + historical item prices&lt;br&gt;Constraints and row-level locks&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=17;spacingTop=10;spacingBottom=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.4;fontFamily=Arial;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="1260" y="345" width="240" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p01-20" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#0F766E;strokeWidth=1.6;fontColor=#334155;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;jettySize=auto;" parent="1" source="p01-16" target="p01-17" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p01-21" value="HTTP /api&#xa;JSON responses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;fontColor=#334155;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;jettySize=auto;" parent="1" source="p01-17" target="p01-18" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p01-22" value="parameterized SQL&#xa;pgx + transactions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#7C3AED;strokeWidth=1.6;fontColor=#334155;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;jettySize=auto;" parent="1" source="p01-18" target="p01-19" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p01-23" value="Nginx (Compose) or Vite (development) forwards /api. See page 11 for physical ports and hosting." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#475569;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="400" y="570" width="1090" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p01-24" value="&lt;div style=&quot;font-family:Arial;font-size:16px;color:#0F172A;font-weight:700;line-height:1.3;&quot;&gt;01  Read the catalog&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:14px;color:#334155;line-height:1.5;margin-top:9px;&quot;&gt;Search, filters, pagination, movement history, and summary cards come from server data.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=17;spacingTop=10;spacingBottom=10;fillColor=#ECFDF5;strokeColor=#0F766E;strokeWidth=1.4;fontFamily=Arial;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="60" y="735" width="460" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p01-25" value="&lt;div style=&quot;font-family:Arial;font-size:16px;color:#0F172A;font-weight:700;line-height:1.3;&quot;&gt;02  Change inventory safely&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:14px;color:#334155;line-height:1.5;margin-top:9px;&quot;&gt;Order creation, cancellation, and stock adjustments commit their balance and ledger writes together.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=17;spacingTop=10;spacingBottom=10;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.4;fontFamily=Arial;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="570" y="735" width="460" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p01-26" value="&lt;div style=&quot;font-family:Arial;font-size:16px;color:#0F172A;font-weight:700;line-height:1.3;&quot;&gt;03  Keep the record&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:14px;color:#334155;line-height:1.5;margin-top:9px;&quot;&gt;PostgreSQL persists the ledger. A product with history cannot be deleted; it may be deactivated.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=17;spacingTop=10;spacingBottom=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.4;fontFamily=Arial;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="1080" y="735" width="460" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
